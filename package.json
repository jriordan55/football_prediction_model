{
  "name": "cfb-pbp-model",
  "version": "1.0.0",
  "private": true,
  "description": "CFB play-by-play model data pipeline with rotating odds, live ESPN context, and adaptive scraping",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "capture": "node capture_odds.js",
    "capture:once": "node capture_odds.js --once",
    "scrape": "node scraper.js",
    "scrape:once": "node scraper.js --once",
    "scrape:live": "node scraper.js --live-session",
    "telegram:test": "node telegram_test.js",
    "sharp": "node sharp_money_server.js",
    "cfb-odds": "node cfb_odds_server.js",
    "boltodds:test": "node scripts/boltodds_test.js",
    "odds:snapshot": "node scripts/refresh_last_odds_snapshot.js",
    "onyx:pull": "node scripts/pull_onyx_cfb.js",
    "onyx:export-slate": "node scripts/export_onyx_slate_csv.js",
    "onyx:export-slate:refresh": "node scripts/export_onyx_slate_csv.js --refresh",
    "slate:hydrate": "node -e \"require('./puntandrally/onyx_slate_scan').warmOnyxSlateCache()\"",
    "cfbd:ppa-players": "node scripts/pull_cfbd_ppa_players_games.js",
    "cfbd:recruiting": "node scripts/pull_cfbd_recruiting.js",
    "cfbd:expected-ppa": "node scripts/build_2026_expected_ppa.js",
    "cfbd:backtest": "node scripts/backtest_ppa_betting.js",
    "cfbd:pull-advanced-weekly": "node scripts/pull_cfbd_advanced_weekly.js --start 2016 --end 2025",
    "sdvs:pull-summaries": "node scripts/pull_sdvs_team_summaries.js --start 2016 --end 2025",
    "cfbd:weekly-sp": "node scripts/build_weekly_sp_plus.js",
    "cfbd:calibrate-sp": "node scripts/calibrate_sp_scale.js",
    "cfbd:calibrate-sp-margin": "node scripts/calibrate_sp_margin.js",
    "billc:pull-sp": "node scripts/pull_billc_sp_plus.js --discover",
    "sp:refresh": "node scripts/refresh_sp_latest.js",
    "billc:calibrate-sp-margin": "node scripts/calibrate_billc_sp_margin.js",
    "billc:backtest": "node scripts/backtest_billc_sp_betting.js",
    "billc:pull-lines": "node scripts/pull_billc_book_lines.js",
    "billc:backtest-filtered": "node scripts/backtest_billc_sp_filtered.js",
    "billc:spread-ev-buckets": "node scripts/analyze_billc_spread_ev_buckets.js",
    "cfb:export-calibration": "node scripts/export_cfb_calibration_data.js",
    "cfb:fit-ml-calibration": "node scripts/fit_cfb_ml_calibration.js",
    "cfb:calibration-report": "python scripts/sports_analytics/calibration_report.py --input data/calibration/cfb_home_ml_predictions.csv --target y_true --probability p_pred --group-col season --out data/calibration/cfb_home_ml_calibration_report.json",
    "cfb:calibration-plot": "python scripts/sports_analytics/plot_reliability_curve.py --input data/calibration/cfb_home_ml_predictions.csv --out public/cfb-ml-reliability.png --calibration-json data/calibration/cfb_home_ml_calibration_report.json",
    "cfb:calibration": "npm run cfb:export-calibration && npm run cfb:fit-ml-calibration && npm run cfb:calibration-report && npm run cfb:calibration-plot",
    "cfbd:ratings": "node scripts/pull_cfbd_ratings.js",
    "cfbd:elo-schedules": "node scripts/build_elo_weekly_from_schedules.js",
    "cfbd:backtest-elo": "node scripts/backtest_elo_betting.js",
    "pr:pull": "node scripts/pull_pr_stats.js",
    "pr:pull-extras": "node scripts/pull_pr_extras.js --start 2014 --end 2025",
    "pr:pull-seasons": "node scripts/pull_pr_seasons.js",
    "pr:teams": "node scripts/build_team_registry.js",
    "pr:validate-teams": "node scripts/validate_team_mapping.js && node scripts/test_team_collisions.js",
    "pr:simulate": "node scripts/simulate_cfb_pr.js",
    "cfg:slugs": "node scripts/build_cfg_team_slugs.js",
    "cfg:seed": "node scripts/seed_cfg_rosters.js",
    "cfg:pull-players": "node scripts/pull_cfg_players.js",
    "nfelo:refresh": "python scripts/fetch_nfelo_ratings.py",
    "pr:backtest": "node scripts/backtest_pr_betting.js",
    "pr:backtest-elo": "node scripts/backtest_pr_elo_weekly.js",
    "pr:backtest-nola": "node scripts/backtest_pr_nolookahead.js",
    "build:pages": "node build_pages.js",
    "streamlit": "streamlit run streamlit_app/app.py",
    "streamlit:pricing": "streamlit run streamlit_app/pricing_app.py",
    "pricing:backfill": "python scripts/backfill_pricing_history.py",
    "pricing:snapshot": "python scripts/snapshot_pricing_day.py",
    "pricing:snapshot:open": "python scripts/snapshot_pricing_day.py --capture-type daily_open",
    "pricing:snapshot:close": "python scripts/snapshot_pricing_day.py --capture-type daily_close",
    "pricing:inplay": "python scripts/snapshot_inplay_pricing.py",
    "streamlit:autohedge": "streamlit run streamlit_app/autohedge_lab_app.py",
    "streamlit:install": "pip install -r streamlit_app/requirements.txt",
    "dk:team-yards": "node scripts/fetch_dk_team_yards.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "ws": "^8.21.1"
  }
}
