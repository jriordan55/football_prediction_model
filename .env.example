# CollegeFootballData.com — free key at https://collegefootballdata.com/key
# CFBD_API_KEY=
# CFBD_REQUEST_DELAY_MS=200

# BoltOdds — one key for server, scraper, capture (see boltodds_config.js)
BOLTODDS_API_KEY=your_boltodds_api_key

PORT=3000
HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API (github.io live mode)
CORS_ORIGINS=https://jriordan55.github.io,http://localhost:3000

# Free Telegram alerts (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional thresholds
TELEGRAM_MIN_EV=0.03
TELEGRAM_MIN_ARB=0.01
TELEGRAM_ALERT_TTL_MS=1800000

# The Odds API (the-odds-api.com) — manual pull only (Football Labs Refresh / /api/cfb-odds/refresh)
# THE_ODDS_API_KEY=
# Onyx Odds is via OpticOdds only (not on The Odds API)
# THE_ODDS_API_BOOKMAKERS=draftkings,pinnacle
# THE_ODDS_API_EVENT_LIMIT=0
# THE_ODDS_API_EXTENDED_EVENT_LIMIT=80
# THE_ODDS_API_EVENT_CONCURRENCY=4
# THE_ODDS_API_MARKET_BATCH=6

# OddsJam / OpticOdds API (Sharp Money — npm run sharp, manual ?refresh=1)
OPTICODDS_API_KEY=
# Onyx Odds CFB board: npm run onyx:pull or http://localhost:3000/onyx-odds
# Scrapes https://api.onyxodds.com/api/public/odds (same data as app.onyxodds.com)
# ONYX_LEAGUE=NCAAF
# SHARP_PORT=3002

# Streamlit CFB dashboard: npm run streamlit  →  http://localhost:8501
# Otter Odds v2 — same feed as https://app.otterodds.com/odds-screen (Premium subscription)
# Your subscription IS the API access; you still need a bearer token (not your login password).
#
# Option A — API key from Otter dashboard (recommended, does not expire hourly):
#   1. Log into app.otterodds.com with your Premium account
#   2. Open Settings → API / Developer (or use the key builder at docs.otterodds.com while signed in)
#   3. Create/copy key → paste below
# OTTER_ODDS_API_KEY=
#
# Option B — session token from browser (works immediately; expires ~1h, recopy when odds stop updating):
#   1. Log into app.otterodds.com → open Odds Screen
#   2. DevTools (F12) → Network → filter "api.otterodds"
#   3. Click any request → Request Headers → copy the value after "Authorization: Bearer "
# OTTER_ODDS_SESSION_TOKEN=
#
# OTTER_ODDS_ENABLED=1
# OTTER_ODDS_REFRESH_SEC=3
# OTTER_ODDS_PHASE=pregame
# OTTER_ODDS_LEAGUE_CFB=ncaaf
# OTTER_ODDS_LEAGUE_NFL=nfl
# Fallback: 4C Odds (https://4codds.com) — no API key required
# FOURC_ODDS_ENABLED=1
# In-play runner week hints (GitHub Actions sets these in pricing-inplay.yml)
# CFB_SEASON=2026
# CFB_WEEK=3
# NFL_SEASON=2026
# NFL_WEEK=2
# FOURC_ODDS_REFRESH_SEC=30
# FOURC_ODDS_MARKET_FETCH_LIMIT=40
# FOOTBALL_LABS_API=http://localhost:3000
# Append-only CSV log for odds + projections (default on): data/streamlit_csv_log/streamlit_feed_YYYY-MM-DD.csv
# STREAMLIT_CSV_LOG=1
# Optional Excel audit trail (slow): STREAMLIT_AUDIT_EXPORT=1
# SHARP_MIN_LIQUIDITY=250
# SHARP_LEAGUES=nfl,ncaaf
# SHARP_EXCHANGE_BOOKS=Novig,ProphetX,Kalshi
# BoltOdds — optional restrict books (default: all 35 from get_info)
# BOLTODDS_SPORTSBOOKS=fanduel,draftkings,betmgm,novig,kalshi

# OpticOdds all-books CFB board (when BoltOdds WS blocked)
# OPTICODDS_SPORTSBOOKS=DraftKings,FanDuel,BetMGM,Novig,ProphetX,Kalshi,Polymarket
